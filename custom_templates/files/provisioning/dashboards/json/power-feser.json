            "uid": "edtefswx63a4ga"
          },
          "query": "from(bucket: \"homeassistant\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  // Standard Filter\r\n  |> filter(fn: (r) => r[\"domain\"] == \"sensor\")\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"°C\")\r\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\r\n\r\n  // Spezifischer Ausschluss (bleibt bestehen)\r\n  |> filter(fn: (r) => r[\"entity_id\"] != \"eg_office_marvin_pc_main_marvin_pc_gputemperatur\")\r\n\r\n  // --- UPDATE: REGEX AUSSCHLUSS ---\r\n  // Schließt jetzt 'handy', 'weather', 'michelstadt' UND 'office_temp' aus.\r\n  |> filter(fn: (r) => r[\"entity_id\"] !~ /handy|weather|michelstadt|office_temp|ab_|temp_inside/)\r\n\r\n  // Gruppierung und Aggregation\r\n  |> group(columns: [\"entity_id\", \"host\"]) \r\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\r\n  |> rename(columns: {_value: \"Temperature\"})\r\n  |> yield(name: \"All_Temperatures\")\r\n",
          "refId": "A"
        }
      ],
      "title": "Temperatur Innen",
      "type": "timeseries"
