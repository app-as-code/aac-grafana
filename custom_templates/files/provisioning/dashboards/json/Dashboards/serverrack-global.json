          "query": "from(bucket: \"homeassistant\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  // FILTER: Domäne und Measurement (Einheit %)\r\n  |> filter(fn: (r) => r[\"domain\"] == \"sensor\")\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"%\")\r\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\r\n\r\n  // FILTERN DER AUSGEWÄHLTEN SENSOREN: Behält nur diese drei entity_ids\r\n  |> filter(fn: (r) => \r\n    r[\"entity_id\"] == \"ab_balcony_zha_temp_humidity_201_humidity\" \r\n    or r[\"entity_id\"] == \"eg_serverroom_sensor_zha_temp_humidity_201_humidity\" \r\n    or r[\"entity_id\"] == \"michelstadt_luftfeuchtigkeit\"\r\n  )\r\n  \r\n  // GRUPPIERUNG: Erforderlich, um die Aggregation pro Sensor durchzuführen und\r\n  // jeden Sensor als separate Linie im Graphen darzustellen.\r\n  |> group(columns: [\"entity_id\", \"host\"])\r\n  \r\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\r\n  \r\n  // RENAME: Benennt die Zeitreihe um, um die entity_id in der Legende als \"Luftfeuchtigkeit\" anzuzeigen\r\n  |> rename(columns: {_value: \"Luftfeuchtigkeit\"})\r\n  |> yield(name: \"Selected_Humidity\")",
